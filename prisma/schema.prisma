generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  EMPLOYEE
  HR
}

enum AttendanceStatusType {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  UNKNOWN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ─────────────────────────────────────────────
// Company
// ─────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees       User[]
  leaveRequests   LeaveRequest[]
  yearlySerials   YearlySerial[]
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique @default("")
  email        String   @unique
  passwordHash String   @default("")
  name         String
  phone        String?
  role         Role     @default(EMPLOYEE)
  companyId    String   @default("default-company")
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Profile
  department       String?
  designation      String?
  joiningDate      DateTime?
  location         String?
  managerId        String?
  manager          User?    @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates     User[]   @relation("EmployeeManager")
  profilePhotoUrl  String?
  avatarUrl        String?
  isActive         Boolean  @default(true)

  // Attendance shift settings
  shiftStartTime       String   @default("09:00")
  shiftDurationMinutes Int      @default(480)
  gracePeriodMinutes   Int      @default(15)

  // Auth / Security
  mustChangePassword        Boolean  @default(false)
  emailVerified             Boolean  @default(false)
  verificationToken         String?  @unique
  verificationTokenExpiry   DateTime?

  // Tracking
  yearlySerial  Int?
  joiningYear   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         Session[]
  attendances      Attendance[]
  leaveAllocations LeaveAllocation[]
  leaveRequests    LeaveRequest[]    @relation("LeaveRequests")
  leaveDecisions   LeaveRequest[]    @relation("LeaveDecisions")
  notifications    Notification[]
}

// ─────────────────────────────────────────────
// Session
// ─────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
}

// ─────────────────────────────────────────────
// Yearly Serial (for Employee ID generation)
// ─────────────────────────────────────────────

model YearlySerial {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year      Int
  lastSerial Int    @default(0)

  @@unique([companyId, year])
}

// ─────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────

model Attendance {
  id                String              @id @default(cuid())
  userId            String?
  employeeId        String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime?           @db.Date
  businessDate      String?
  status            AttendanceStatusType @default(UNKNOWN)
  checkIn           DateTime?
  checkOut          DateTime?
  workHoursMinutes  Int?
  extraHoursMinutes Int?
  isLate            Boolean             @default(false)
  isCorrected       Boolean             @default(false)
  correctedBy       String?
  correctedAt       DateTime?
  correctionReason  String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([userId, date])
  @@unique([employeeId, businessDate], name: "unique_employee_daily_attendance")
  @@index([employeeId, businessDate])
}

// ─────────────────────────────────────────────
// Leave (Member 3)
// ─────────────────────────────────────────────

model Leave {
  id          String   @id @default(cuid())
  employeeId  String?
  startDate   String
  endDate     String
  type        String   @default("PAID")
  status      String   @default("PENDING")
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
}

// ─────────────────────────────────────────────
// LeaveAllocation (Member 4)
// ─────────────────────────────────────────────

model LeaveAllocation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType String
  year      Int
  totalDays Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, leaveType, year])
  @@index([userId, year])
}

// ─────────────────────────────────────────────
// LeaveRequest (Member 1 & 4)
// ─────────────────────────────────────────────

model LeaveRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation("LeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  startDate       DateTime?   @db.Date
  endDate         DateTime?   @db.Date
  fromDate        DateTime?
  toDate          DateTime?
  days            Float?
  leaveType       String      @default("ANNUAL")
  reason          String?
  remarks         String?     @db.Text
  attachmentPath  String?
  attachmentName  String?
  status          LeaveStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  decidedById     String?
  decidedBy       User?       @relation("LeaveDecisions", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  rejectionReason String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────
// Holiday
// ─────────────────────────────────────────────

model Holiday {
  id              String   @id @default(cuid())
  date            String   @unique
  name            String
  isNonWorkingDay Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model PublicHoliday {
  id   String   @id @default(cuid())
  name String
  date DateTime @unique
  year Int

  @@index([year])
}

// ─────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  type        String
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  message     String    @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}
