datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  name                 String
  password             String?      @default("password123")
  role                 String       @default("EMPLOYEE") // EMPLOYEE | ADMIN | HR
  department           String?
  designation          String?
  joiningDate          DateTime?
  isActive             Boolean      @default(true)
  avatarUrl            String?
  shiftStartTime       String       @default("09:00") // HH:mm format
  shiftDurationMinutes Int          @default(480)    // 8 hours (480 minutes)
  gracePeriodMinutes   Int          @default(15)     // 15 minutes grace period
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  attendances          Attendance[]
  leaves               Leave[]

  // Member 4 relations
  leaveAllocations     LeaveAllocation[]
  leaveRequests        LeaveRequest[]    @relation("LeaveRequests")
  leaveDecisions       LeaveRequest[]    @relation("LeaveDecisions")
  notifications        Notification[]
}

model Attendance {
  id                String    @id @default(uuid())
  employeeId        String
  employee          User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  businessDate      String    // YYYY-MM-DD string in company timezone
  checkIn           DateTime  // UTC timestamp
  checkOut          DateTime? // UTC timestamp
  workHoursMinutes  Int?      // Duration in minutes
  extraHoursMinutes Int?      // Overtime in minutes
  status            String    @default("PRESENT") // PRESENT | ABSENT | HALF_DAY | LEAVE
  isLate            Boolean   @default(false)
  isCorrected       Boolean   @default(false)
  correctedBy       String?
  correctedAt       DateTime?
  correctionReason  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([employeeId, businessDate], name: "unique_employee_daily_attendance")
  @@index([employeeId, businessDate])
  @@index([businessDate])
  @@index([status])
}

model Leave {
  id          String   @id @default(uuid())
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate   String   // YYYY-MM-DD
  endDate     String   // YYYY-MM-DD
  type        String   @default("PAID") // PAID | UNPAID | SICK
  status      String   @default("PENDING") // APPROVED | PENDING | REJECTED
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, startDate, endDate])
}

model Holiday {
  id              String   @id @default(uuid())
  date            String   @unique // YYYY-MM-DD
  name            String
  isNonWorkingDay Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// ─────────────────────────────────────────────
// Member 4 — Leave, Allocation & Notification Models
// ─────────────────────────────────────────────

model LeaveAllocation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType String   // PAID_TIME_OFF | SICK_LEAVE | UNPAID_LEAVE
  year      Int
  totalDays Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, leaveType, year])
  @@index([userId, year])
}

model LeaveRequest {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation("LeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  leaveType       String    // PAID_TIME_OFF | SICK_LEAVE | UNPAID_LEAVE
  fromDate        DateTime
  toDate          DateTime
  days            Float
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  remarks         String?   @db.Text
  attachmentPath  String?
  attachmentName  String?

  requestedAt     DateTime  @default(now())
  decidedById     String?
  decidedBy       User?     @relation("LeaveDecisions", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  rejectionReason String?   @db.Text

  @@index([userId, status])
  @@index([fromDate, toDate])
  @@index([userId, fromDate, toDate])
}

model PublicHoliday {
  id   String   @id @default(uuid())
  name String
  date DateTime @unique
  year Int

  @@index([year])
}

model Notification {
  id          String    @id @default(uuid())
  type        String    // LEAVE_SUBMITTED | LEAVE_APPROVED | LEAVE_REJECTED | LEAVE_PENDING_ADMIN | PASSWORD_RESET
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  message     String    @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}
